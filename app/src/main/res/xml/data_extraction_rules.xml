<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: ni la nube ni la transferencia a otro equipo llevan el token ni el PIN.
     La llave que cifra el token vive en el Keystore y tampoco se transfiere. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="secure_tokens.xml" />
        <exclude domain="sharedpref" path="kiosk_pin.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secure_tokens.xml" />
        <exclude domain="sharedpref" path="kiosk_pin.xml" />
    </device-transfer>
</data-extraction-rules>
